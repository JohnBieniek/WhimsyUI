# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/reports/

# next.js
/.next/
/out/
/.open-next/

# production
/build

# Local source archives (not needed by the deployed site)
/archive/*.zip
/archive/Whimsy_Context_Catalog.z0?
/Whimsy_Context_Catalog.z0?

# Separate local project; not part of this deployment
/whimsy-contact-form/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
cloudflare-env.d.ts

*storybook.log
storybook-static
